{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-gateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/auth/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/auth" } ]
      },
      "candidate-route": {
        "ClusterId": "candidate-cluster",
        "Match": { "Path": "/candidates/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/candidates" } ]
      },
      "employer-route": {
        "ClusterId": "employer-cluster",
        "Match": { "Path": "/employers/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/employers" } ]
      },
      "job-route": {
        "ClusterId": "job-cluster",
        "Match": { "Path": "/jobs/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/jobs" } ]
      },
      "application-route": {
        "ClusterId": "application-cluster",
        "Match": { "Path": "/applications/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/applications" } ]
      },
      "resume-search-route": {
        "ClusterId": "resume-search-cluster",
        "Match": { "Path": "/resume-search/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/resume-search" } ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": { "Address": "https+http://auth-service" }
        }
      },
      "candidate-cluster": {
        "Destinations": {
          "destination1": { "Address": "https+http://candidate-service" }
        }
      },
      "employer-cluster": {
        "Destinations": {
          "destination1": { "Address": "https+http://employer-service" }
        }
      },
      "job-cluster": {
        "Destinations": {
          "destination1": { "Address": "https+http://job-service" }
        }
      },
      "application-cluster": {
        "Destinations": {
          "destination1": { "Address": "https+http://application-service" }
        }
      },
      "resume-search-cluster": {
        "Destinations": {
          "destination1": { "Address": "https+http://resume-search-service" }
        }
      }
    }
  }
}
