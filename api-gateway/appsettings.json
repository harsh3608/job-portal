{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/auth/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/auth" } ]
      },
      "candidate-route": {
        "ClusterId": "candidate-cluster",
        "Match": { "Path": "/candidates/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/candidates" } ]
      },
      "employer-route": {
        "ClusterId": "employer-cluster",
        "Match": { "Path": "/employers/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/employers" } ]
      },
      "job-route": {
        "ClusterId": "job-cluster",
        "Match": { "Path": "/jobs/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/jobs" } ]
      },
      "application-route": {
        "ClusterId": "application-cluster",
        "Match": { "Path": "/applications/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/applications" } ]
      },
      "resume-search-route": {
        "ClusterId": "resume-search-cluster",
        "Match": { "Path": "/resume-search/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/resume-search" } ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://auth-service:8080" }
        }
      },
      "candidate-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://candidate-service:8080" }
        }
      },
      "employer-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://employer-service:8080" }
        }
      },
      "job-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://job-service:8080" }
        }
      },
      "application-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://application-service:8080" }
        }
      },
      "resume-search-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://resume-search-service:8080" }
        }
      }
    }
  }
}
